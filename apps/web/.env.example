# Tyrell web app (apps/web). Set these in apps/web/.env.local for `pnpm web:dev`, or in the Vercel project.

# Reown AppKit (wallet connection with WalletConnect). Create a project at https://dashboard.reown.com,
# add your site's domain to its allowlist, then paste the project id here or in Vercel's env settings.
# The id is public (it ships in the page). Without it the site uses plain browser wallets (EIP-6963).
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Force a wallet stack: reown (AppKit even without a project id: browser wallets only, no relay) or injected.
# NEXT_PUBLIC_WALLET_MODE=

# Live data from your own control process (read-only, server-side). Without it the console shows the
# recorded run in public/snapshot.json. Control requires its bearer token: TYRELL_HOME/api-token on that
# machine, or the TYRELL_API_TOKEN control was started with.
# TYRELL_API_URL=http://127.0.0.1:7878
# TYRELL_API_TOKEN=

# The playground's live AI demo: a Fortytwo key (Qwen). Server-side only; set a spend limit on the key.
# Without it the demo replays recorded runs.
# FORTYTWO_API_KEY=
# Optional shared rate limit for the demo across server instances (Vercel KV or Upstash Redis, REST API).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# Absolute URL used in social cards and llms.txt. On Vercel it defaults to the production domain.
# TYRELL_SITE_URL=https://example.com
