# Tyrell environment variables. Copy to .env, fill in what you need, and load it into your shell before
# running `pnpm tyrell …` (nothing loads .env automatically):
#
#   set -a; . ./.env; set +a
#
# Never put a private key in this file: keys live in encrypted keystores under TYRELL_HOME/keys. The
# network, RPC list, chain id and contract addresses are not variables: they are in TYRELL_HOME/config.json
# and TYRELL_HOME/deployment-<chainId>.json, written by `tyrell setup` and `tyrell deploy`.
# Every variable is documented in the docs: Reference → Configuration.

# ── Home and keys ────────────────────────────────────────────────────────────────────────────────────
# One home per network, so testnet keys are never reused on mainnet.
TYRELL_HOME=~/.tyrell-testnet
# Projection cache (default TYRELL_HOME/projection.sqlite).
# TYRELL_DB=

# Passphrases, one per role (I-12). For role R the first that exists wins:
#   KEYSTORE_PASSPHRASE_FILE_<R>, then TYRELL_HOME/pass.d/<r>, then the shared KEYSTORE_PASSPHRASE_FILE
#   (default TYRELL_HOME/pass), which is accepted on a local test chain only.
# `tyrell setup keys --new-passphrase` creates TYRELL_HOME/pass.d/<role> for you. Files must be chmod 600.
# KEYSTORE_PASSPHRASE_FILE_CONTROL=/home/tyrell-control/pass
# KEYSTORE_PASSPHRASE_FILE=~/.tyrell/pass
# Unsafe: accept one shared passphrase and cross-role key access on testnet/mainnet (single-user machine only).
# TYRELL_INSECURE_SHARED_KEYS=1
# Abort on a local chain too when a process can open another role's key (always on for testnet/mainnet).
# TYRELL_STRICT_KEYS=1
# scrypt cost for new keystores (default 2^15; below 2^14 is refused outside a local chain).
# TYRELL_SCRYPT_N=32768

# ── Network ──────────────────────────────────────────────────────────────────────────────────────────
# RPC list written into a new config.json by `tyrell setup keys` (default: the network's endpoints).
# On testnet and mainnet the first two must be different URLs; any after them are a tie-breaking fallback.
# QIE_RPC_URLS=https://rpc4testnet.qie.digital,https://rpc5testnet.qie.digital,https://rpc1testnet.qie.digital
QIE_MCP_URL=https://mcp.qie.digital/mcp
# Where QIE ID names are looked up (default mainnet: names exist only there).
# QIE_ID_NETWORK=mainnet

# ── Storage ──────────────────────────────────────────────────────────────────────────────────────────
# Required with `--store pinata`. Never commit it.
PINATA_JWT=
# Only the probe reads this; the CLI takes the gateway as `setup keys --gateway`.
# PINATA_GATEWAY=https://<your>.mypinata.cloud

# ── Control ──────────────────────────────────────────────────────────────────────────────────────────
# Read-only view API on 127.0.0.1 (default 7878; 0 turns it off).
# TYRELL_API_PORT=7878
# Its bearer token (default: TYRELL_HOME/api-token, created chmod 600 on first start).
# TYRELL_API_TOKEN=
# Unix socket mode (default 600). 660 plus a shared group for one OS user per process.
# TYRELL_SOCKET_MODE=660
# `tyrell status` warns when the submitter has less than this much QIEV3 for gas (default 0.05).
# TYRELL_LOW_GAS=0.05
# Base URL `tyrell blast` prints for the console (default http://localhost:3000).
# TYRELL_CONSOLE_URL=http://localhost:3000
# Seconds the owner-transaction page waits for the wallet before giving up (default 600).
# TYRELL_OWNER_TIMEOUT=600

# ── Steward and the AI judge ─────────────────────────────────────────────────────────────────────────
# A Fortytwo key alone selects Qwen (qwen/qwen3.8-27b) on api.fortytwo.network, for both.
FORTYTWO_API_KEY=
# Or any OpenAI-compatible endpoint (wins over the Fortytwo key):
# LLM_PROVIDER=          # fortytwo to use Fortytwo with LLM_API_KEY
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_REASONING_EFFORT=  # default low on Fortytwo
# The judge can use its own model; each SENTINEL_LLM_* falls back to the LLM_* of the same name.
# The agent's LLM_API_KEY is only sent to the agent's own host.
# SENTINEL_LLM_PROVIDER=
# SENTINEL_LLM_BASE_URL=
# SENTINEL_LLM_API_KEY=
# SENTINEL_LLM_MODEL=
# SENTINEL_LLM_REASONING_EFFORT=  # default none on Fortytwo

# ── Sentinel (ingest) ────────────────────────────────────────────────────────────────────────────────
SENTINEL_POLL_MS=15000
SENTINEL_THRESHOLD=60
# Transfers at or below this many base units are dust.
SENTINEL_DUST=1000
# Blocks per scan window (default 5000).
# SENTINEL_WINDOW=5000
# off turns the AI judge off; its timeout in ms (default 15000).
# SENTINEL_AI=auto
# SENTINEL_AI_TIMEOUT_MS=15000
AUTO_QUARANTINE_BLOCKLIST=true
# Blocklist file (default TYRELL_HOME/blocklist.json) and extra addresses to watch besides the vault.
# TYRELL_BLOCKLIST=
# TYRELL_WATCH=0x…,0x…

# ── Probe (pnpm probe / tyrell probe) ────────────────────────────────────────────────────────────────
# PROBE_QIE_ID=someone.qie        # a known QIE ID for P-6 resolve / reverse lookup
# QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5   # token checked in P-7

# The web app has its own list: apps/web/.env.example.
