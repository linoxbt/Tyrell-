# Copy to .env and fill in. Never put a private key in this file: keys live in keystores.

# network
TYRELL_NETWORK=testnet                 # mainnet | testnet | local
# Optional overrides; defaults come from packages/chain (QIE_RPC_URLS for the selected network)
# QIE_RPC_URLS=https://rpc1mainnet.qie.digital,https://rpc2mainnet.qie.digital,https://rpc3mainnet.qie.digital
QIE_MCP_URL=https://mcp.qie.digital/mcp

# deployment (written by scripts/deploy.ts)
TYRELL_ACCT=0x
LANE_REGISTRY=0x
MEMORY_ANCHOR=0x
TYRELL_LEDGER=0x
GUARDED_VAULT=0x
QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5   # Verify (probe P-7)

# keys: paths only, never the key itself
KEYSTORE_DIR=~/.tyrell/keys
KEYSTORE_PASSPHRASE_FILE=~/.tyrell/pass   # chmod 600; one per process in production

# storage
PINATA_JWT=
PINATA_GATEWAY=https://<your>.mypinata.cloud
TYRELL_DB=~/.tyrell/projection.sqlite

# agent
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# sentinel
SENTINEL_POLL_MS=15000
SENTINEL_THRESHOLD=60
AUTO_QUARANTINE_BLOCKLIST=true

# probe only (scripts/probe.ts)
# PROBE_QIE_ID=someone.qie        # a known QIE ID for P-6 resolve / reverse lookup
